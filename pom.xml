<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.4</version>
        <relativePath/>
    </parent>

    <groupId>com.codingwithjohn</groupId>
    <artifactId>java-login-fingerprint</artifactId>
    <version>0.1.0</version>
    <name>java-login-fingerprint</name>
    <description>Simple Spring Boot login system with a Fingerprint device-intelligence check on login. Starter code for a Coding With John video.</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <repositories>
        <!-- Fingerprint Java Server SDK v8 is published via JitPack, not Maven Central. -->
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- BCrypt password hashing only (the crypto module, not Spring Security's web filters). -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- Fingerprint Java Server SDK v8 (Server API v4). v7 and earlier used the
             deprecated Server API v3 and must not be used. -->
        <dependency>
            <groupId>com.github.fingerprintjs</groupId>
            <artifactId>java-sdk</artifactId>
            <version>v8.8.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
